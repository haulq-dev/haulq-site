---
/** A rate confirmation read into a proposed load, with the source text under each field and a missing field said out loud. */
import AppFrame from './AppFrame.astro';

const fields = [
  { k: 'Broker', v: 'Lakeshore Freight LLC', src: '“LAKESHORE FREIGHT LLC — Carrier Confirmation”' },
  { k: 'Load #', v: 'LF-207731', src: '“Load Number: LF-207731”' },
  { k: 'Rate', v: '$1,350.00', src: '“Total Carrier Pay  $1,350.00 USD”', num: true },
  { k: 'Pickup', v: 'Dallas, TX · Oct 7, 08:00', src: '“Shipper: … DALLAS TX 75212  Appt 10/07 0800”' },
  { k: 'Delivery', v: 'Memphis, TN · Oct 8, 14:00', src: '“Consignee: … MEMPHIS TN 38118  10/08 1400”' },
];
---
<AppFrame path="/proposals/rc-207731" active="Documents" label="A rate confirmation read by HaulQ Docs: broker, load number, rate and stops each shown with the line of the document it came from, weight reported as missing, and a button to create the load.">
  <div class="grid gap-5 sm:grid-cols-5">
    <div class="hidden sm:col-span-2 sm:block">
      <div class="aspect-[8.5/11] border border-line bg-wash p-4">
        <div class="h-2 w-2/3 bg-ink/70"></div>
        <div class="mt-1.5 h-1.5 w-1/3 bg-mute/50"></div>
        <div class="mt-5 space-y-1.5">
          {[90, 75, 82, 60, 88, 70].map((w) => <div class="h-1 bg-mute/40" style={`width:${w}%`}></div>)}
        </div>
        <div class="mt-4 border border-brand/50 bg-brand-50 p-1.5">
          <div class="h-1.5 w-3/4 bg-brand/60"></div>
        </div>
        <div class="mt-4 space-y-1.5">
          {[80, 66, 92, 54, 78].map((w) => <div class="h-1 bg-mute/40" style={`width:${w}%`}></div>)}
        </div>
      </div>
      <div class="mk-num mt-1.5 truncate text-[11px] text-mute">RateCon_LF-207731.pdf · from your mailbox</div>
    </div>

    <div class="sm:col-span-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mk-display text-xl">Rate confirmation</span>
        <span class="mk-pill mk-pill-brand">Ready to become a load</span>
      </div>
      <dl class="mt-3 text-xs sm:text-sm">
        {fields.map((f) => (
          <div class="border-t border-line py-2">
            <div class="flex justify-between gap-3">
              <dt class="mk-label pt-1 text-mute">{f.k}</dt>
              <dd class:list={['text-right font-medium', f.num && 'mk-num']}>{f.v}</dd>
            </div>
            <div class="mk-num mt-1 truncate text-[10.5px] text-mute">{f.src}</div>
          </div>
        ))}
        <div class="border-t border-line py-2">
          <div class="flex justify-between gap-3">
            <dt class="mk-label pt-1 text-mute">Weight</dt>
            <dd><span class="mk-pill mk-pill-warn">Not on the document</span></dd>
          </div>
        </div>
      </dl>
      <div class="mt-3 flex gap-2">
        <span class="rounded-sm bg-brand px-3 py-1.5 text-xs font-semibold text-white">Create the load</span>
        <span class="rounded-sm border border-line px-3 py-1.5 text-xs font-semibold text-slate">Dismiss</span>
      </div>
    </div>
  </div>
</AppFrame>

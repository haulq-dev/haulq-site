---
/** Feasibility for one truck on one load, naming the constraint that decided it, then what's near the stop. */
import AppFrame from './AppFrame.astro';

const nearby = [
  ['Truck stop', 'Exit 48 Travel Plaza', '2.1 mi'],
  ['Weigh station', 'I-85 northbound', '6.4 mi'],
  ['Truck wash', 'Southside Truck Wash', '3.0 mi'],
  ['Repair shop', 'Mack Ave Diesel ★ 4.7', '4.2 mi'],
] as const;
---
<AppFrame path="/loads/4421" active="Loads" label="HaulQ Routes on a load: the route is not feasible for this truck because a 13 foot 2 inch clearance is lower than the truck's 13 foot 6 inch height, followed by truck stops, a weigh station, a truck wash and a repair shop near the delivery.">
  <div class="mk-label text-mute">Can this truck run it?</div>
  <div class="mt-2 grid gap-2 text-xs sm:grid-cols-2 sm:text-sm">
    <div class="border border-line p-2.5">
      <div class="mk-label text-mute">Truck</div>
      <div class="mt-1 font-medium">Truck 03 <span class="mk-num text-[11px] text-mute">13′6″ · 80,000 lb · 53′</span></div>
    </div>
    <div class="border border-line p-2.5">
      <div class="mk-label text-mute">Load 4421</div>
      <div class="mt-1 font-medium">Atlanta, GA → Charlotte, NC</div>
    </div>
  </div>

  <div class="mt-3 border-l-2 border-[#b42318] bg-[#fef3f2] px-3 py-2.5">
    <div class="flex items-center gap-2">
      <span class="mk-pill mk-pill-bad">Not feasible</span>
      <span class="text-xs font-semibold text-[#b42318] sm:text-sm">Height</span>
    </div>
    <div class="mt-1.5 text-xs text-slate sm:text-sm">
      The truck-legal route passes under a <span class="mk-num">13′2″</span> clearance. This truck is <span class="mk-num">13′6″</span>.
    </div>
  </div>

  <div class="mk-label mt-5 text-mute">Near the delivery</div>
  <ul class="mt-1.5 text-xs sm:text-sm">
    {nearby.map(([kind, name, dist]) => (
      <li class="flex items-baseline gap-3 border-t border-line py-2">
        <span class="mk-label w-24 shrink-0 text-mute">{kind}</span>
        <span class="min-w-0 flex-1 truncate font-medium">{name}</span>
        <span class="mk-num text-[11px] text-slate">{dist}</span>
      </li>
    ))}
  </ul>
</AppFrame>

---
/**
 * A browser window around an app mockup.
 *
 * The mockups stand in for screenshots, built in markup so they stay sharp,
 * cost nothing to load and can't drift into showing a real carrier's data.
 * Everything inside is decorative to a screen reader; `label` says in words
 * what the picture shows. "Sample data" in the address bar keeps it honest.
 *
 * Keep them to features that are built. `consts.ts` is the list of what each
 * product does today; a mockup showing a "Coming next" item is a promise.
 */
import Logo from '../Logo.astro';

interface Props {
  label: string;
  path: string;
  /** The app's nav item to underline. Omit for the chromeless pages, like broker tracking. */
  active?: 'Loads' | 'Insights' | 'Documents' | 'Pay';
  org?: string;
  class?: string;
}
const { label, path, active, org = 'Ridgeway Transport', class: cls = '' } = Astro.props;
const nav = ['Loads', 'Insights', 'Documents', 'Pay'] as const;
---
<figure role="img" aria-label={label} class:list={['overflow-hidden rounded-xl border border-line bg-white text-left text-ink shadow-2xl shadow-ink/25', cls]}>
  <div aria-hidden="true">
    <div class="flex items-center gap-3 border-b border-line bg-wash px-3 py-2">
      <span class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
      </span>
      <span class="mk-num min-w-0 flex-1 truncate rounded bg-white px-2.5 py-1 text-[11px] text-slate ring-1 ring-line">app.haulq.ai{path}</span>
      <span class="mk-label hidden shrink-0 text-mute sm:inline">Sample data</span>
    </div>
    {active && (
      <div class="flex items-center gap-3 border-b border-line px-4 py-2.5 sm:px-5">
        <Logo class="!h-4 sm:!h-5" />
        <span class="hq-slash h-3.5 w-px"></span>
        <span class="mk-label truncate text-mute">{org}</span>
        <span class="ml-auto hidden gap-4 md:flex">
          {nav.map((item) => (
            <span class:list={['mk-label pb-1', item === active ? 'border-b-2 border-brand text-ink' : 'text-mute']}>{item}</span>
          ))}
        </span>
      </div>
    )}
    <div class="p-4 sm:p-6">
      <slot />
    </div>
  </div>
</figure>

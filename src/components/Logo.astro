---
/**
 * HaulQ wordmark.
 *
 * Two prepared rasters, both with transparent backgrounds, generated from the
 * supplied artwork:
 *   /logo.png        navy wordmark, for light surfaces
 *   /logo-white.png  white wordmark with the orange tail, for dark surfaces
 *
 * Source files are public/HaulQ Logo.png and public/HaulQ Logo Favicon.png.
 * If a vector version ever arrives, swap the <img> for an inline <svg> here;
 * this is the only place the logo is referenced.
 */
interface Props { class?: string; tone?: 'dark' | 'light'; }
const { class: cls = '', tone = 'dark' } = Astro.props;
const src = tone === 'light' ? '/logo-white.png' : '/logo.png';
---
<img
  src={src}
  alt="HaulQ"
  width="900"
  height="250"
  decoding="async"
  class:list={["h-8 w-auto", cls]}
/>

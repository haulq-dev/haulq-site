---
interface Props { class?: string; tone?: 'dark' | 'light'; }
const { class: cls = '', tone = 'dark' } = Astro.props;
const word = tone === 'light' ? 'text-white' : 'text-ink';
---
<span class:list={["inline-flex items-center gap-2.5", cls]}>
  <svg viewBox="0 0 100 100" class="h-7 w-7 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id={`hq-${tone}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="50%" stop-color="#FF6800" />
        <stop offset="50%" stop-color={tone === 'light' ? '#94A3B8' : '#1E293B'} />
      </linearGradient>
    </defs>
    <g fill="none" stroke={`url(#hq-${tone})`} stroke-width="21" stroke-linejoin="miter" stroke-miterlimit="10">
      <path d="M9 47 L34 74 L79 26" />
    </g>
    <path d="M92 12 L94 44 L60 14 Z" fill={`url(#hq-${tone})`} />
  </svg>
  <span class:list={["text-xl font-bold tracking-tight", word]}>HaulQ</span>
</span>

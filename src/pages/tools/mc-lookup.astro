---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Free MC and DOT lookup"
  description="Check a carrier or broker's operating authority, insurance filing and safety record. Free, no account.">
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-16">
      <span class="inline-flex rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Free tool</span>
      <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">MC and DOT lookup</h1>
      <p class="mt-4 text-lg text-slate-300">
      Check operating authority, insurance filing status and safety record before you take the load.
        Sourced from FMCSA, with the time it was fetched shown on every result.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-14">
    <form id="mc-form" class="flex flex-col gap-3 sm:flex-row">
      <input id="mc-input" name="mc" required
        placeholder="MC123456"
        autocomplete="off" autocapitalize="characters" spellcheck="false"
        aria-describedby="mc-hint"
        class="flex-1 rounded-full border border-line px-5 py-3.5 text-sm tracking-wide focus:border-brand focus:ring-0" />
      <button class="rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand/25 hover:bg-brand-600">
        Look it up
      </button>
    </form>

    <!-- Format guidance. Chips are clickable and fill the input. -->
    <div id="mc-hint" class="mt-4 flex flex-col gap-3 border-l-2 border-line pl-4 sm:flex-row sm:items-start sm:gap-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-mute sm:pt-1.5">Accepted</span>
      <div class="flex flex-wrap gap-2">
        {[
          ['MC123456', 'Motor carrier number'],
          ['DOT1234567', 'USDOT number'],
          ['123456', 'Digits alone work too'],
        ].map(([sample, label]) => (
          <button type="button" data-sample={sample}
            class="mc-sample group rounded-full border border-line bg-white px-3 py-1.5 text-left transition hover:border-brand hover:bg-brand-50">
            <span class="block text-xs font-semibold text-ink group-hover:text-brand-600">{sample}</span>
            <span class="block text-[0.6875rem] text-mute">{label}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="mt-3 pl-4 text-xs text-mute">
      Spaces, dashes and the MC or DOT prefix are all fine. Six digits or fewer is read as an MC number.
    </p>

    <div id="mc-result" class="mt-8"></div>

    <div class="mt-14 rounded-2xl border border-brand-100 bg-brand-50 p-7 text-sm text-slate">
      <p class="font-semibold">What this is and is not</p>
      <p class="mt-2">
        This is a risk assessment built from public federal records, not a guarantee. Insurance status
        reflects what has been filed, which is not the same as coverage being in force today. Never infer
        coverage from a location ping or a certificate someone emailed you.
      </p>
    </div>

    <div class="mt-8">
      <a href="/products/verify" class="text-sm font-medium text-brand hover:underline">
        See what HaulQ Verify adds &rarr;
      </a>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('mc-form') as HTMLFormElement | null;
  const input = document.getElementById('mc-input') as HTMLInputElement | null;
  const out = document.getElementById('mc-result') as HTMLElement | null;

  const card = (title: string, body: string) =>
    `<div class="rounded-2xl border border-line p-6">
       <h2 class="display text-lg font-semibold">${title}</h2>
       <p class="mt-2 text-sm text-slate">${body}</p>
     </div>`;

  // Clicking a format example fills the input and runs the lookup.
  document.querySelectorAll<HTMLButtonElement>('.mc-sample').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!input) return;
      input.value = btn.dataset.sample ?? '';
      input.focus();
      form?.requestSubmit();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = (input?.value || '').trim();
    if (!q || !out) return;
    out.innerHTML = card('Looking up', 'Checking federal records...');
    try {
      const res = await fetch(`/api/verify?q=${encodeURIComponent(q)}`);
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      if (!data.found) {
        out.innerHTML = card('Nothing found', 'No record matched that number. Check the digits and try again.');
        return;
      }
      const rows: [string, string][] = [
        ['Legal name', data.legalName ?? '—'],
        ['DBA', data.dbaName ?? '—'],
        ['DOT number', data.dotNumber ?? '—'],
        ['Operating status', data.operatingStatus ?? '—'],
        ['Entity type', data.entityType ?? '—'],
        ['Power units', data.powerUnits ?? '—'],
        ['Drivers', data.drivers ?? '—'],
        ['Safety rating', data.safetyRating ?? 'Not rated'],
        ['Location', data.location ?? '—'],
      ];
      out.innerHTML = `
        <div class="rounded-2xl border border-line p-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="display text-xl font-semibold">${data.legalName ?? 'Result'}</h2>
            <span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand-600 ring-1 ring-brand/30">${data.operatingStatus ?? 'Unknown'}</span>
          </div>
          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            ${rows.map(([k, v]) => `
              <div class="border-t border-slate-100 pt-3">
                <dt class="text-xs uppercase tracking-wide text-mute">${k}</dt>
                <dd class="mt-0.5 text-sm">${v}</dd>
              </div>`).join('')}
          </dl>
          <p class="mt-5 text-xs text-mute">Source: FMCSA. Fetched ${data.fetchedAt ?? 'just now'}. Risk assessment, not a guarantee.</p>
        </div>
        <div class="mt-4 rounded-2xl border border-dashed border-brand-100 bg-brand-50 p-5">
          <p class="text-sm text-slate">Want change alerts when this carrier's authority or insurance moves?</p>
          <a href="/waitlist" class="mt-3 inline-block rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-600">Join the waitlist</a>
        </div>`;
    } catch {
      out.innerHTML = card(
        'Lookup is not live yet',
        'This tool goes live with HaulQ Verify. Join the waitlist and we will tell you the day it does.'
      );
    }
  });
</script>

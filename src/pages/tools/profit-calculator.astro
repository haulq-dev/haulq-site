---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Free load profit calculator"
  description="Work out what a load actually pays after fuel, deadhead, tolls and factoring. Free, no account.">
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-16">
      <span class="inline-flex rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Free tool</span>
      <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">Load profit calculator</h1>
      <p class="mt-4 text-lg text-slate-300">
        Rate per mile hides deadhead, fuel and factoring. This shows what lands in your pocket.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-14">
    <form id="calc" class="grid gap-5 rounded-2xl border border-line bg-wash p-6 sm:grid-cols-2 sm:p-8">
      {[
        ['rate', 'Line haul rate ($)', '1450'],
        ['loaded', 'Loaded miles', '620'],
        ['deadhead', 'Deadhead miles', '85'],
        ['mpg', 'Truck MPG', '9'],
        ['fuel', 'Diesel ($/gal)', '3.85'],
        ['tolls', 'Tolls ($)', '45'],
        ['driver', 'Driver pay ($/mile, 0 if owner)', '0'],
        ['fixed', 'Fixed cost per day ($)', '180'],
        ['days', 'Days on this load', '2'],
        ['factor', 'Factoring fee (%)', '3'],
      ].map(([id, label, val]) => (
        <label class="block">
          <span class="text-sm font-medium">{label}</span>
          <input id={id} type="number" step="any" value={val}
            class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm focus:border-brand focus:ring-0" />
        </label>
      ))}
    </form>

    <div id="out" class="mt-8 rounded-2xl border border-line bg-white p-7 shadow-lg shadow-ink/5"></div>

    <div class="mt-10 rounded-2xl border border-brand-100 bg-brand-50 p-7">
      <p class="text-sm text-slate">
        This uses figures you type in. HaulQ Insights builds the same number from your real fuel receipts,
        tolls, maintenance reserve and settlements, and estimates fuel burn from the terrain on the actual
        route before you accept the load.
      </p>
      <a href="/products/insights" class="mt-3 inline-block text-sm font-medium text-brand hover:underline">
        See HaulQ Insights &rarr;
      </a>
    </div>
  </section>
</Base>

<script>
  const ids = ['rate','loaded','deadhead','mpg','fuel','tolls','driver','fixed','days','factor'];
  const get = (id: string) => Number((document.getElementById(id) as HTMLInputElement)?.value || 0);
  const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  function render() {
    const out = document.getElementById('out');
    if (!out) return;
    const rate = get('rate'), loaded = get('loaded'), deadhead = get('deadhead');
    const mpg = get('mpg') || 1, fuelPrice = get('fuel'), tolls = get('tolls');
    const driverRate = get('driver'), fixed = get('fixed'), days = get('days'), factorPct = get('factor');

    const total = loaded + deadhead;
    const fuelCost = (total / mpg) * fuelPrice;
    const driverCost = total * driverRate;
    const fixedCost = fixed * days;
    const factorCost = rate * (factorPct / 100);
    const costs = fuelCost + tolls + driverCost + fixedCost + factorCost;
    const net = rate - costs;
    const perTotalMile = total ? net / total : 0;
    const rpmAll = total ? rate / total : 0;
    const rpmLoaded = loaded ? rate / loaded : 0;

    const row = (k: string, v: string, strong = false) =>
      `<div class="flex justify-between border-t border-slate-100 py-2 ${strong ? 'font-semibold' : ''}">
         <span class="${strong ? '' : 'text-slate'}">${k}</span><span>${v}</span></div>`;

    out.innerHTML = `
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="display text-lg font-semibold">Net on this load</h2>
        <span class="display text-3xl font-semibold ${net >= 0 ? 'text-brand' : 'text-red-600'}">${money(net)}</span>
      </div>
      <div class="mt-4 text-sm">
        ${row('Line haul', money(rate))}
        ${row('Fuel (' + total.toFixed(0) + ' total miles)', '-' + money(fuelCost))}
        ${row('Tolls', '-' + money(tolls))}
        ${row('Driver pay', '-' + money(driverCost))}
        ${row('Fixed cost (' + days + ' days)', '-' + money(fixedCost))}
        ${row('Factoring', '-' + money(factorCost))}
        ${row('Net', money(net), true)}
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-3 text-sm">
        <div class="rounded-xl bg-brand-50 p-4"><div class="text-xs uppercase tracking-wide text-mute">Rate / loaded mile</div><div class="mt-1 font-semibold">${money(rpmLoaded)}</div></div>
        <div class="rounded-xl bg-brand-50 p-4"><div class="text-xs uppercase tracking-wide text-mute">Rate / total mile</div><div class="mt-1 font-semibold">${money(rpmAll)}</div></div>
        <div class="rounded-xl bg-brand-50 p-4"><div class="text-xs uppercase tracking-wide text-mute">Net / total mile</div><div class="mt-1 font-semibold">${money(perTotalMile)}</div></div>
      </div>
      <p class="mt-4 text-xs text-mute">Deadhead is ${total ? ((deadhead / total) * 100).toFixed(0) : 0}% of your miles on this run.</p>`;
  }

  ids.forEach((id) => document.getElementById(id)?.addEventListener('input', render));
  render();
</script>

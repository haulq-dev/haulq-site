---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-32 text-center">
      <p class="display text-7xl font-semibold text-brand">404</p>
      <h1 class="mt-4 text-3xl font-semibold sm:text-4xl">Wrong exit.</h1>
      <p class="mt-3 text-slate-300">That page does not exist.</p>
      <a href="/" class="mt-9 inline-block rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-white hover:bg-brand-600">
        Back to the homepage
      </a>
    </div>
  </section>
</Base>

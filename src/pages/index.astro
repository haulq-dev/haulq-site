---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { PRODUCTS, SITE, AUTOPILOT } from '../consts';
---
<Base description={SITE.category}>
  <!-- HERO, dark -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-20 sm:pt-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">{SITE.wedge}</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-semibold leading-[1.03] sm:text-6xl">
        Run every load.<br /><span class="text-brand">Know every dollar.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-slate-300">
        HaulQ is the operating system a small carrier runs its whole business on. Find the load, prove it
        is feasible, keep the broker informed, turn the paperwork into cash, and know the margin before
        you say yes.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/waitlist" class="rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-600">
          Join the waitlist
        </a>
        <a href="/tools/mc-lookup" class="rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white transition hover:border-brand hover:text-brand">
          Try the free MC lookup
        </a>
      </div>
      <p class="mt-6 text-sm text-mute">
        No cut of your gross. Most owner-operators hand a dispatcher 5 to 10 percent of every load.
      </p>
    </div>
  </section>

  <!-- STAT BAND, warm tint -->
  <section class="border-b border-brand-100 bg-brand-50">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-14 sm:grid-cols-3">
      {[
        ['0%', 'of your gross. Software pricing, not a slice of every load.'],
        ['Sourced', 'Authority and insurance pulled from the source and timestamped. Never a forwarded PDF.'],
        ['Box truck', 'Liftgate, dock height and residential modelled from day one.'],
      ].map(([big, small]) => (
        <div>
          <div class="display text-4xl font-semibold text-brand">{big}</div>
          <p class="mt-2 text-sm text-slate">{small}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PRODUCTS, white -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="text-3xl font-semibold sm:text-4xl">Seven products. One record.</h2>
        <p class="mt-3 max-w-2xl text-slate">
          Start with one. Add the rest without re-entering a single truck, driver, broker or load.
        </p>
      </div>
      <a href="/products" class="hidden shrink-0 text-sm font-semibold text-brand hover:underline sm:block">All products &rarr;</a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((product) => <ProductCard product={product} />)}
      <div class="flex flex-col justify-between rounded-2xl border-2 border-dashed border-brand-100 bg-brand-50 p-6">
        <div>
          <h3 class="display text-lg font-semibold">{AUTOPILOT.name}</h3>
          <p class="mt-2 font-medium text-brand-600">{AUTOPILOT.tagline}</p>
          <p class="mt-3 text-sm text-slate">{AUTOPILOT.blurb}</p>
        </div>
        <span class="mt-5 text-sm font-semibold text-mute">Add-on, not a separate app.</span>
      </div>
    </div>
  </section>

  <!-- LOOP, dark -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl font-semibold sm:text-4xl">The loop</h2>
      <p class="mt-3 max-w-2xl text-slate-300">
        Each product is useful alone. Together they learn from every load you run.
      </p>
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Find', 'Candidate loads filtered by your real constraints, ranked by what they actually pay you.'],
          ['Check', 'Broker authority, insurance and payment history before you commit.'],
          ['Run', 'Live position, ETA and detention evidence without a single check call.'],
          ['Collect', 'Photograph the BOL. Invoice assembles, factoring packet goes out, margin reconciles.'],
        ].map(([title, body], i) => (
          <li class="relative rounded-2xl border border-white/10 bg-white/5 p-6">
            <span class="display text-sm font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-2 display text-xl font-semibold">{title}</h3>
            <p class="mt-2 text-sm text-slate-300">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FREE TOOLS, wash -->
  <section class="border-y border-line bg-wash">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl font-semibold sm:text-4xl">Free, right now</h2>
      <p class="mt-3 max-w-2xl text-slate">No account, no card. These stay free.</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {[
          ['MC and DOT lookup', 'Check a broker or carrier’s operating authority, insurance filing and safety record, sourced from FMCSA with a timestamp on every fact.', '/tools/mc-lookup'],
          ['Load profit calculator', 'What a load actually pays after deadhead, fuel, tolls and factoring. Not rate per mile.', '/tools/profit-calculator'],
        ].map(([title, body, href]) => (
          <a href={href} class="group rounded-2xl border border-line bg-white p-8 transition hover:border-brand hover:shadow-lg hover:shadow-ink/5">
            <span class="inline-flex rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Free</span>
            <h3 class="mt-4 display text-xl font-semibold">{title}</h3>
            <p class="mt-2 text-sm text-slate">{body}</p>
            <span class="mt-5 inline-block text-sm font-semibold text-brand group-hover:underline">Open it &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WAITLIST -->
  <section class="mx-auto max-w-3xl px-5 py-20">
    <h2 class="text-3xl font-semibold sm:text-4xl">Tell us what to build first</h2>
    <p class="mt-3 text-slate">
      We are building in the open. Pick the products you would actually use and it changes our order of work.
    </p>
    <div class="mt-8 rounded-2xl border border-line bg-white p-6 shadow-lg shadow-ink/5 sm:p-8">
      <WaitlistForm />
    </div>
  </section>
</Base>

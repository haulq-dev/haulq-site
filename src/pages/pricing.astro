---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { PRODUCTS, AUTOPILOT, APP_URL } from '../consts';

// These must match the Stripe catalog (haulq-app/docs/stripe-catalog.md) and
// haulq-app/apps/web/src/components/PlansScreen.tsx. A price change means
// editing Stripe, the plans screen and this page, or Checkout charges one
// number while this page quotes another.
const CORE_MONTHLY = 49;
const FLEET_PLATFORM_MONTHLY = 199;
const FLEET_PER_TRUCK_MONTHLY = 49;

const core = PRODUCTS.filter((p) => p.plan === 'Core');
const fleetOnly = PRODUCTS.filter((p) => p.plan === 'Fleet');
const comingSoon = PRODUCTS.filter((p) => p.plan === null);
---
<Base title="Pricing" description="Software pricing, not a percentage of your gross.">
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="hq-stripes absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-20">
      <h1 class="text-4xl font-semibold sm:text-5xl">Pricing</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">
        Two plans, a flat monthly price, and no demo required to see what it costs. Sign up and
        pay on the web; the iPhone app works with whichever plan you are on.
      </p>
      <p class="mt-6 inline-block rounded-full bg-brand px-4 py-1.5 text-sm font-semibold text-white">
        Pilot pricing: sign up now and keep your price
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16">
    <div class="mb-8 rounded-2xl border-2 border-brand bg-brand-50 p-6 sm:p-7" role="note">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Pilot pricing · limited time</p>
      <h2 class="display mt-2 text-xl font-semibold text-ink">Lock in today's price before it goes up</h2>
      <p class="mt-3 text-slate">
        The prices below are early pilot prices, open for a limited time to carriers accepted into
        the HaulQ pilot program. Spots are limited: sign up, and we'll review your carrier and let
        you know once you're in. Pricing will increase as more of HaulQ launches. <strong class="font-semibold text-ink">Carriers who subscribe now keep the price
        they signed up at for as long as their subscription stays active</strong>, even after full
        pricing applies to new customers.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="flex flex-col rounded-2xl border border-line p-7">
        <h2 class="display text-xl font-semibold">HaulQ Core</h2>
        <p class="mt-1 text-sm font-medium text-brand-600">Paperwork to paid, for up to 5 trucks</p>
        <p class="mt-4 text-slate">
          An owner-operator or a small operation of up to 5 trucks. Everything between the rate
          confirmation and the money landing.
        </p>

        <p class="mt-6 border-t border-line pt-5">
          <span class="num text-3xl font-semibold text-ink">${CORE_MONTHLY}</span>
          <span class="text-slate">/month</span>
        </p>

        <ul class="mt-5 space-y-3">
          {core.map((p) => (
            <li class="flex items-start gap-3">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              <span class="text-sm"><a href={`/products/${p.slug}`} class="font-semibold text-ink hover:text-brand">{p.name}</a> <span class="text-slate">{p.tagline}</span></span>
            </li>
          ))}
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full ring-2 ring-inset ring-brand-100"></span>
            <span class="text-sm"><span class="font-semibold text-ink">{AUTOPILOT.name}</span> <span class="text-slate">Early access: payment reminders and invoice emails, sent only once you approve.</span></span>
          </li>
        </ul>

        <a href={APP_URL} class="mt-auto pt-7">
          <span class="block rounded-full border border-ink px-6 py-3 text-center text-sm font-semibold text-ink transition hover:border-brand hover:text-brand">Start with Core</span>
        </a>
      </div>

      <div class="relative flex flex-col rounded-2xl border-2 border-brand bg-brand-50 p-7">
        <span class="absolute -top-3 left-7 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Grows with you</span>
        <h2 class="display text-xl font-semibold">HaulQ Fleet</h2>
        <p class="mt-1 text-sm font-medium text-brand-600">Everything, for every truck</p>
        <p class="mt-4 text-slate">
          Multi-truck operations. Everything in Core, plus live tracking and routing for every
          truck you run.
        </p>

        <p class="mt-6 border-t border-brand-100 pt-5">
          <span class="num text-3xl font-semibold text-ink">${FLEET_PLATFORM_MONTHLY}</span>
          <span class="text-slate">/month</span>
          <span class="block text-sm text-slate">plus ${FLEET_PER_TRUCK_MONTHLY} per truck</span>
        </p>

        <ul class="mt-5 space-y-3">
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
            <span class="text-sm font-semibold text-ink">Everything in Core</span>
          </li>
          {fleetOnly.map((p) => (
            <li class="flex items-start gap-3">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              <span class="text-sm"><a href={`/products/${p.slug}`} class="font-semibold text-ink hover:text-brand">{p.name}</a> <span class="text-slate">{p.tagline}</span></span>
            </li>
          ))}
          {comingSoon.map((p) => (
            <li class="flex items-start gap-3">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full ring-2 ring-inset ring-brand-100"></span>
              <span class="text-sm"><span class="font-semibold text-mute">{p.name}</span> <span class="text-mute">joins Fleet at no extra cost when it ships</span></span>
            </li>
          ))}
        </ul>

        <a href={APP_URL} class="mt-auto pt-7">
          <span class="block rounded-full bg-brand px-6 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-600">Start with Fleet</span>
        </a>
      </div>
    </div>

    <p class="mt-6 text-sm text-mute">
      Both plans include the HaulQ iPhone app for every driver and member, and repair-shop search
      from any load.
    </p>

    <div class="mt-10 space-y-5 rounded-2xl bg-ink p-8 text-white">
      <p class="text-slate-300"><strong class="font-semibold text-white">No percentage of gross.</strong> A dispatcher taking 7 percent from a truck grossing $200,000 costs about <span class="font-semibold text-brand">$14,000 a year</span>. Software should not be priced that way.</p>
      <p class="text-slate-300"><strong class="font-semibold text-white">Move up when you need to.</strong> Start on Core and email <a href="mailto:hello@haulq.ai" class="text-brand hover:underline">hello@haulq.ai</a> when you want Fleet. Nothing you have set up has to be entered again.</p>
      <p class="text-slate-300"><strong class="font-semibold text-white">The MC lookup stays free.</strong> No account, no card, no trial clock.</p>
    </div>

    <div class="mt-14 rounded-2xl border border-line bg-wash p-6 sm:p-8">
      <h2 class="text-2xl font-semibold">Not sure which fits?</h2>
      <p class="mt-2 text-slate">Tell us what you run and we'll follow up with the right plan for your setup.</p>
      <div class="mt-6"><WaitlistForm /></div>
    </div>
  </section>
</Base>
